# DO NOT COMMIT WITH REAL VALUES. This is a template — copy it to
# secret.yaml, fill in real secrets, apply, then DELETE the local file.
#
# In production, prefer External Secrets / Vault / AWS Secrets Manager so the
# raw credentials never live in a YAML file. The Patroni pods reference these
# names via PATRONI_SUPERUSER_* and PATRONI_REPLICATION_* env in
# patroni-statefulset.yaml — keep the keys in sync if you rename anything.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-superuser
  labels:
    app.kubernetes.io/name: patroni
    app.kubernetes.io/part-of: zkcex
type: Opaque
stringData:
  username: postgres
  # 32 char minimum in prod. Generate with: openssl rand -base64 32
  password: "REPLACE_ME_SUPERUSER_PASSWORD"
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-replication-user
  labels:
    app.kubernetes.io/name: patroni
    app.kubernetes.io/part-of: zkcex
type: Opaque
stringData:
  # Patroni expects the replication role to be named "standby" by default
  # (PATRONI_REPLICATION_USERNAME). If you change this here, also set
  # PATRONI_REPLICATION_USERNAME in patroni-statefulset.yaml.
  username: standby
  password: "REPLACE_ME_REPLICATION_PASSWORD"
---
# Optional: a separate app-level Postgres user that services use day-to-day,
# instead of letting them connect as the superuser. Created by the
# `auth_server_pg_bootstrap.sh` script after the cluster is up.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-app-user
  labels:
    app.kubernetes.io/name: patroni
    app.kubernetes.io/part-of: zkcex
type: Opaque
stringData:
  username: app
  password: "REPLACE_ME_APP_PASSWORD"
  database: zkcex_auth
