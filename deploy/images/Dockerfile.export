# syntax=docker/dockerfile:1.7
FROM zkcex-base:latest AS final
ARG SERVICE=export

COPY --chown=65532:65532 tools/export_server.py /app/tools/export_server.py

ENV PORT=5540
EXPOSE 5540
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s \
    CMD ["python", "/app/healthcheck.py", "5540", "/export/health"]
CMD ["-u", "/app/tools/export_server.py", "5540"]
