# syntax=docker/dockerfile:1.7
FROM zkcex-base:latest AS final
ARG SERVICE=api-key

COPY --chown=65532:65532 tools/api_key_server.py /app/tools/api_key_server.py

ENV PORT=5550
EXPOSE 5550
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s \
    CMD ["python", "/app/healthcheck.py", "5550", "/api-keys/health"]
CMD ["-u", "/app/tools/api_key_server.py", "5550"]
