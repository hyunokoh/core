# syntax=docker/dockerfile:1.7
FROM zkcex-base:latest AS final
ARG SERVICE=pol-py

COPY --chown=65532:65532 tools/pol_server.py /app/tools/pol_server.py

ENV PORT=5503
EXPOSE 5503
# pol_server.py does not expose /health — probe its /pol/server-info endpoint.
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s \
    CMD ["python", "/app/healthcheck.py", "5503", "/pol/server-info"]
CMD ["-u", "/app/tools/pol_server.py", "5503"]
