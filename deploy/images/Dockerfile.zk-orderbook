# syntax=docker/dockerfile:1.7
FROM zkcex-base:latest AS final
ARG SERVICE=zk-orderbook

COPY --chown=65532:65532 tools/zk_orderbook.py /app/tools/zk_orderbook.py

ENV PORT=5660
EXPOSE 5660
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s \
    CMD ["python", "/app/healthcheck.py", "5660", "/zk-trade/health"]
CMD ["-u", "/app/tools/zk_orderbook.py", "5660"]
