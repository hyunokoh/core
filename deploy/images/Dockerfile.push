# syntax=docker/dockerfile:1.7
FROM zkcex-base:latest AS final
ARG SERVICE=push

COPY --chown=65532:65532 tools/push_server.py /app/tools/push_server.py

ENV PORT=5580
EXPOSE 5580
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s \
    CMD ["python", "/app/healthcheck.py", "5580", "/push/health"]
CMD ["-u", "/app/tools/push_server.py", "5580"]
