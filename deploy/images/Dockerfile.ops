# syntax=docker/dockerfile:1.7
FROM zkcex-base:latest AS final
ARG SERVICE=ops

COPY --chown=65532:65532 tools/ops_server.py /app/tools/ops_server.py

ENV PORT=5620
EXPOSE 5620
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s \
    CMD ["python", "/app/healthcheck.py", "5620", "/health"]
CMD ["-u", "/app/tools/ops_server.py", "5620"]
